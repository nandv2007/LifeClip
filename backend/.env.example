# ----- LifeClip backend environment -----
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file (it is gitignored).

# Cloudinary (from https://console.cloudinary.com/ -> "Go to API Keys")
CLOUDINARY_CLOUD_NAME=tecwmb40
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lifeclip

# Database (defaults to a local SQLite file; use Postgres in production)
# DATABASE_URL=postgresql+psycopg://lifeclip:lifeclip@localhost:5432/lifeclip
DATABASE_URL=

# Upload limits
MAX_UPLOAD_BYTES=10485760

# Data retention applied to new sessions (days media is kept; 0 = keep until user deletes)
RETENTION_DAYS=90

# Comma-separated extra allowed CORS origins for production deployments
ALLOWED_ORIGINS=
