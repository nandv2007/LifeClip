# Production-only API origin for a separately hosted FastAPI backend.
# Do not create frontend/.env.local for local development: Vite's /api proxy
# always targets http://localhost:8787 and the app intentionally ignores this
# value in development builds.
# Omit VITE_API_URL entirely for a same-origin FastAPI + frontend deployment.
VITE_API_URL=https://your-lifeclip-api.example.com
